<Window x:Class="TcpRouteTray.AdvancedTomlWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TcpRoute2 — Advanced TOML" Width="900" Height="700" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#171A22" Foreground="#F2F4F8"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Advanced TOML" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="直接编辑完整配置；保存前会验证监听地址和 TOML 配置模型。" Foreground="#9CA6B7" Margin="0,5,0,16"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="配置名称" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ProfileName" Grid.Column="1" Background="#10141B" Foreground="#F2F4F8" BorderBrush="#394153" Padding="9,6"/></Grid>
        <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                 Background="#10141B" Foreground="#E8ECF3" CaretBrush="#48C8D8" BorderBrush="#394153" Padding="14"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="未修改" Foreground="#9CA6B7" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Width="90" Padding="10,7" Margin="0,0,8,0" Click="Cancel"/><Button Content="保存配置" Width="110" Padding="10,7" Background="#48C8D8" Foreground="#10151B" FontWeight="SemiBold" Click="Save"/></StackPanel></Grid>
    </Grid>
</Window>
