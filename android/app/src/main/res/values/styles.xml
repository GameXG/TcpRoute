<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="SectionEyebrow">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/teal_pressed</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CardTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="BodyMuted">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="FormLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="FormInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DangerButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SegmentButton" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:textColor">@color/text_segment</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
</resources>
